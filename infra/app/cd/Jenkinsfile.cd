pipeline {
    agent { label "host-agent" }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '1.0.0',
            description: 'Image tag to deploy (must already exist in Docker Hub)'
        )
    }

    environment {
        TF_DIR    = "${WORKSPACE}/infra/app/terraform"
        IMAGE_TAG = "${params.IMAGE_TAG}"
        APP_NAMESPACE = "app"
        BACKEND_DEPLOYMENT = "backend"
        FRONTEND_DEPLOYMENT = "frontend"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm

                // // or use checkout scm
                // git url: "https://github.com/mairuu/sca-project.git", branch: "main" 
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'cd ${TF_DIR} && terraform init'
            }
        }

        stage('Inject Secrets & Plan') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS'),
                    string(credentialsId: 'MINIO_PASSWORD',   variable: 'MINIO_PASS'),
                    string(credentialsId: 'POSTGRES_PASSWORD', variable: 'PG_PASS'),
                    string(credentialsId: 'POSTGRES_USERNAME', variable: 'PG_USER'),
                    string(credentialsId: 'JWT_SECRET',        variable: 'JWT_PASS'),
                    string(credentialsId: 'MINIO_ROOT_USER', variable: 'MINIO_USER')
                ]) {
                    sh '''
                        cd ${TF_DIR}

                        terraform plan \
                          -var="docker_hub_user=${DOCKER_USER}" \
                          -var="image_tag=${IMAGE_TAG}" \
                          -var="postgres_password=${PG_PASS}" \
                          -var="postgres_username=${PG_USER}" \
                          -var="minio_password=${MINIO_PASS}" \
                          -var="minio_root_user=${MINIO_USER}" \
                          -var="jwt_secret=${JWT_PASS}" \
                          -out=tfplan
                    '''
                }
            }
        }

        stage('Apply') {
            steps {
                sh '''
                    cd ${TF_DIR}
                    terraform apply -auto-approve tfplan
                '''
            }
        }

        stage('Verify Rollout') {
            steps {
                sh '''
                    kubectl rollout status deployment/${BACKEND_DEPLOYMENT}  -n ${APP_NAMESPACE} --timeout=120s
                    kubectl rollout status deployment/${FRONTEND_DEPLOYMENT} -n ${APP_NAMESPACE} --timeout=120s
                '''
            }
        }
    }

    post {
        always {
            sh 'rm -f ${TF_DIR}/tfplan || true'
            cleanWs()
        }

        failure {
            sh '''
                echo "=== Deployment failed. Rolling back... ==="
                kubectl rollout undo deployment/${BACKEND_DEPLOYMENT}  -n ${APP_NAMESPACE} || true
                kubectl rollout undo deployment/${FRONTEND_DEPLOYMENT} -n ${APP_NAMESPACE} || true
            '''
        }
    }
}