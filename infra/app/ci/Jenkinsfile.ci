pipeline {
    agent { label "builder" }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '1.0.0',
            description: 'Docker image tag to build and push (e.g. 1.0.0)'
        )
    }

    environment {
        IMAGE_TAG = "${params.IMAGE_TAG}"
    }

    stages {
        stage('Checkout') {
            steps {
                cleanWs()

                // checkout scm

                // // or use checkout scm
                git url: "https://github.com/mairuu/sca-project.git", branch: "main" 

                sh 'git submodule update --init --recursive --depth 1'
            }
        }

        stage('Build') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_HUB_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                        script {
                        def FRONTEND_IMAGE = "${DOCKER_HUB_USER}/sca-frontend"
                        def BACKEND_IMAGE = "${DOCKER_HUB_USER}/sca-backend"

                        parallel(
                            'Frontend': {
                                sh "docker build -t ${FRONTEND_IMAGE}:${IMAGE_TAG} ./frontend"
                            },
                            'Backend': {
                                sh "docker build -t ${BACKEND_IMAGE}:${IMAGE_TAG} ./backend"
                            }
                        )
                    }
                }
            }
        }

        stage('Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    script {
                        env.FRONTEND_IMAGE = "${DOCKER_USER}/sca-frontend"
                        env.BACKEND_IMAGE = "${DOCKER_USER}/sca-backend"
                    }
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin

                        docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}
                        docker push ${BACKEND_IMAGE}:${IMAGE_TAG}

                        # Keep :latest in sync
                        docker tag ${FRONTEND_IMAGE}:${IMAGE_TAG} ${FRONTEND_IMAGE}:latest
                        docker tag ${BACKEND_IMAGE}:${IMAGE_TAG}  ${BACKEND_IMAGE}:latest
                        docker push ${FRONTEND_IMAGE}:latest
                        docker push ${BACKEND_IMAGE}:latest
                    '''
                }
            }
        }
    }

    post {
        always {
            withCredentials([usernamePassword(
                credentialsId: 'dockerhub-creds',
                usernameVariable: 'DOCKER_USER',
                passwordVariable: 'DOCKER_PASS'
            )]) {
                script {
                    env.FRONTEND_IMAGE = "${DOCKER_USER}/sca-frontend"
                    env.BACKEND_IMAGE = "${DOCKER_USER}/sca-backend"
                }
                sh '''
                    docker rmi ${FRONTEND_IMAGE}:${IMAGE_TAG} ${FRONTEND_IMAGE}:latest || true
                    docker rmi ${BACKEND_IMAGE}:${IMAGE_TAG}  ${BACKEND_IMAGE}:latest  || true
                    docker logout || true
                '''
            }
            cleanWs()
        }
    }
}
